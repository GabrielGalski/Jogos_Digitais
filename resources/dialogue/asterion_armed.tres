[gd_resource type="Resource" script_class="DialogueSequence" format=3]

[ext_resource type="Script" path="res://tools/dialogue system/dialogue_sequence.gd" id="1_sequence"]
[ext_resource type="Script" path="res://tools/dialogue system/dialogue_choice.gd" id="2_hjem6"]
[ext_resource type="Script" path="res://tools/dialogue system/dialogue_line.gd" id="2_line"]
[ext_resource type="Resource" path="res://resources/dialogue/speakers/asterion.tres" id="3_hjem6"]

[sub_resource type="Resource" id="Threat"]
script = ExtResource("2_line")
speaker = ExtResource("3_hjem6")
text = "Você está apontando esse booster para MIM?! Abaixe essa coisa, monstrinho!"

[sub_resource type="Resource" id="Call"]
script = ExtResource("2_line")
speaker = ExtResource("3_hjem6")
text = "[shake rate=18 level=4]MINOTAUROS![/shake] Tirem esse colecionador de perto das minhas cartas!"
next_line_index = -2

[resource]
script = ExtResource("1_sequence")
sequence_id = &"asterion_armed_response"
lines = Array[ExtResource("2_line")]([SubResource("Threat"), SubResource("Call")])
