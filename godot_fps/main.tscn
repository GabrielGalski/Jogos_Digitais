[sub_resource type="Shader" id="Shader_border_fog"]
code = "shader_type spatial;
render_mode unshaded, fog_disabled, cull_disabled, blend_mix, depth_draw_never;

varying float local_height;

void vertex() {
	local_height = VERTEX.y;
}

void fragment() {
	float height_fade = 1.0 - smoothstep(-2.3, 2.3, local_height);
	float soft_variation = 0.92 + 0.08 * sin(UV.x * 38.0);
	vec3 border_color = vec3(0.035, 0.05, 0.08);
	ALBEDO = border_color;
	EMISSION = border_color;
	ALPHA = height_fade * soft_variation * 0.86;
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_border_fog"]
