{
  "scene_path": "scenes/previews/booster_opener_preview.tscn",
  "viewport_size": {"width": 960, "height": 540},
  "settle_frames": 4,
  "steps": [
    {"type": "assert", "node_path": "Actors/HordePlatform/BoosterOpener", "property": "state", "expected": "closed"},
    {"type": "assert", "assertion": "visible", "node_path": "Actors/HordePlatform/BoosterOpener/ActionPrompt", "expected": false},
    {"type": "assert", "assertion": "visible", "node_path": "Actors/HordePlatform/BoosterOpener/Visuals/Beam", "expected": false},
    {"type": "assert", "node_path": "Actors/HordePlatform/BoosterOpener", "property": "aperture_rect:size:x", "operator": "greater_than", "expected": 20},
    {"type": "ui_report", "label": "preview-960", "fail_on": ["any"], "path": "res://output/booster_opener_preview/ui-960.json"},
    {"type": "screenshot", "path": "res://output/booster_opener_preview/01-closed.png"},
    {"type": "key", "keycode": 69, "physical_keycode": 69, "pressed": true},
    {"type": "key", "keycode": 69, "physical_keycode": 69, "pressed": false},
    {"type": "assert", "node_path": "Actors/HordePlatform/BoosterOpener", "property": "interaction_count", "expected": 0},
    {"type": "key", "keycode": 65, "physical_keycode": 65, "pressed": true},
    {"type": "wait_until", "node_path": "Actors/HordePlatform/BoosterOpener", "property": "state", "expected": "opening", "timeout_seconds": 2},
    {"type": "key", "keycode": 65, "physical_keycode": 65, "pressed": false},
    {"type": "assert", "assertion": "visible", "node_path": "Actors/HordePlatform/BoosterOpener/ActionPrompt", "expected": false},
    {"type": "wait_seconds", "seconds": 0.25},
    {"type": "screenshot", "path": "res://output/booster_opener_preview/02-opening.png"},
    {"type": "assert", "assertion": "visible", "node_path": "Actors/HordePlatform/BoosterOpener/Visuals/ApertureGlow", "expected": true},
    {"type": "assert", "assertion": "visible", "node_path": "Actors/HordePlatform/BoosterOpener/Visuals/Beam", "expected": false},
    {"type": "wait_until", "node_path": "Actors/HordePlatform/BoosterOpener", "property": "state", "expected": "opened", "timeout_seconds": 2},
    {"type": "assert", "assertion": "visible", "node_path": "Actors/HordePlatform/BoosterOpener/ActionPrompt", "expected": true},
    {"type": "assert", "assertion": "visible", "node_path": "Actors/HordePlatform/BoosterOpener/Visuals/ApertureGlow", "expected": true},
    {"type": "assert", "assertion": "visible", "node_path": "Actors/HordePlatform/BoosterOpener/Visuals/Beam", "expected": true},
    {"type": "assert", "assertion": "visible", "node_path": "Actors/HordePlatform/BoosterOpener/Visuals/Cards/Center", "expected": true},
    {"type": "wait_seconds", "seconds": 0.4},
    {"type": "screenshot", "path": "res://output/booster_opener_preview/03-opened.png"},
    {"type": "key", "keycode": 69, "physical_keycode": 69, "pressed": true},
    {"type": "key", "keycode": 69, "physical_keycode": 69, "pressed": false},
    {"type": "assert", "node_path": "Actors/HordePlatform/BoosterOpener", "property": "interaction_count", "expected": 1},
    {"type": "screenshot", "path": "res://output/booster_opener_preview/04-interaction.png"},
    {"type": "set_property", "node_path": "Actors/Nox", "property": "position", "value": {"__type": "Vector2", "x": 130, "y": 50}},
    {"type": "wait_until", "node_path": "Actors/HordePlatform/BoosterOpener", "property": "state", "expected": "closed", "timeout_seconds": 2},
    {"type": "assert", "assertion": "visible", "node_path": "Actors/HordePlatform/BoosterOpener/ActionPrompt", "expected": false},
    {"type": "assert", "assertion": "visible", "node_path": "Actors/HordePlatform/BoosterOpener/Visuals/Cards/Center", "expected": false},
    {"type": "set_property", "node_path": "Actors/Nox", "property": "position", "value": {"__type": "Vector2", "x": 0, "y": 30}},
    {"type": "wait_seconds", "seconds": 0.2},
    {"type": "set_property", "node_path": "Actors/Nox", "property": "position", "value": {"__type": "Vector2", "x": 130, "y": 50}},
    {"type": "wait_seconds", "seconds": 0.08},
    {"type": "set_property", "node_path": "Actors/Nox", "property": "position", "value": {"__type": "Vector2", "x": 0, "y": 30}},
    {"type": "wait_until", "node_path": "Actors/HordePlatform/BoosterOpener", "property": "state", "expected": "opened", "timeout_seconds": 2},
    {"type": "key", "keycode": 82, "physical_keycode": 82, "pressed": true},
    {"type": "key", "keycode": 82, "physical_keycode": 82, "pressed": false},
    {"type": "assert", "node_path": "Actors/HordePlatform/BoosterOpener", "property": "state", "expected": "closed"},
    {"type": "assert", "node_path": "Actors/HordePlatform/BoosterOpener", "property": "interaction_count", "expected": 0},
    {"type": "assert", "assertion": "visible", "node_path": "Actors/HordePlatform/BoosterOpener/Visuals/GroundGlow", "expected": false}
  ]
}
